# Copy to .env.local and fill in. Never commit real values.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# A current Flash-tier model id from AI Studio
GEMINI_MODEL=
# USD per 1M tokens, copied from Google's official pricing page (note the date in docs/decisions.md)
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
# Spend guard: most products Gemini may read in any rolling 24 h, shared by every server instance
# (counted from extraction_events). Default 30, one full catalog. 0 turns extraction off.
GEMINI_DAILY_READ_CAP=30

# --- Supabase (server only, never prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local/offline mode (never on Vercel) ---
# DATA_BACKEND=memory runs without Supabase: the mock store from data/*.json lives in process memory.
DATA_BACKEND=
# Memory mode only: pre-load product facts from data/ground_truth.json (labelled "seeded", never shown
# as AI output) so orders pack with no network or Gemini key. auto (default) = only when GEMINI_API_KEY
# is empty; true = always; false = never (products then need measurement until extracted or measured).
MEMORY_SEED_FACTS=auto

# --- Optional: an external store's Orders API (e.g. Salla later). The built-in store at /store needs nothing here. ---
# When both are set and an order number is not in Rassah's database, Rassah reads it (read-only)
# from the store's Orders API. Leave empty to keep the integration off.
STORE_API_URL=
STORE_API_KEY=

# --- App ---
# true enables the demo controls (fault injection, re-extract, clear cached facts)
DEMO_MODE=false

# --- Optional: Discord/Slack webhook for alerts ---
ALERT_WEBHOOK_URL=
