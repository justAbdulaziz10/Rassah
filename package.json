{
  "name": "rassah",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate-data": "tsx scripts/validate-data.ts",
    "gen-fixtures": "tsx scripts/gen-packing-fixtures.ts",
    "check": "npm run lint && npm run typecheck && npm run validate-data && npm test",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "eval:extraction": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/eval-extraction.ts",
    "eval:packing": "tsx --env-file-if-exists=.env.local scripts/eval-packing.ts"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
