# Demo store settings. This app is separate from Rassah and must NOT use Rassah's Supabase project.

# Shared secret Rassah sends as "Authorization: Bearer <key>" when it reads an order.
# Put the same value in Rassah's STORE_API_KEY.
STORE_API_KEY=

# Where orders are stored. Leave empty locally: orders go to store/.data/orders.json.
# On Vercel use a SEPARATE Supabase project (not Rassah's) and run store/supabase/0001_store.sql there.
STORE_SUPABASE_URL=
STORE_SUPABASE_SERVICE_ROLE_KEY=

# Optional: Rassah's URL, for the "open in Rassah" link the merchant sees after an order.
RASSAH_URL=https://rassah.vercel.app
